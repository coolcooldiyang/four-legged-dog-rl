  <version>0.0.0</version>
  <description>DaMiao quadruped policy deployment controller.</description>
  <maintainer email="2257761605@qq.com">keith</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
